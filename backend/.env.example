# Database
# Runtime traffic uses Neon pooled PostgreSQL. Do not point this at Render PostgreSQL.
DATABASE_URL=postgresql://<pooled-user>:<pooled-password>@<neon-pooled-host>/<database>?sslmode=require
# Alembic runs before Uvicorn and needs Neon's direct (non-pooler) PostgreSQL URL.
MIGRATION_DATABASE_URL=postgresql://<direct-user>:<direct-password>@<neon-direct-host>/<database>?sslmode=require
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# Runtime and browser security
APP_ENV=development
# Production must list the exact public application origin, never '*'.
CORS_ORIGINS=http://127.0.0.1:8001,http://localhost:8001
# Cookie behavior is fixed by the server: ai_agent_session, HttpOnly, SameSite=Lax.
# APP_ENV=production enables Secure on that cookie.
RATE_LIMIT_HASH_SALT=<generate-a-long-random-server-secret>
# Keep false unless a reverse proxy overwrites inbound X-Forwarded-For and its
# source CIDRs are explicitly configured. Production rejects true without CIDRs.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_CIDRS=
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# Request and quota limits
REGISTER_IP_HOURLY_LIMIT=5
LOGIN_IP_15_MINUTE_LIMIT=20
DEMO_IP_HOURLY_LIMIT=5
DEMO_DAILY_LLM_LIMIT=10
DEMO_DAILY_EMBEDDING_CHUNK_LIMIT=100
DEMO_DAILY_EMBEDDING_QUERY_LIMIT=100
REGISTERED_DAILY_LLM_LIMIT=30
GLOBAL_DAILY_LLM_LIMIT=300

# LLM provider. The public portfolio Demo may intentionally use mock so a demo
# session never consumes a real-model budget. Configure a real provider only
# after its credentials, quota, and evidence collection are explicitly approved.
LLM_PROVIDER=openai-compatible
LLM_API_KEY=<provider-api-key>
LLM_BASE_URL=https://<provider-host>/v1
LLM_MODEL=<chat-model-name>
LLM_TIMEOUT_SECONDS=20
# Optional OpenAI-compatible Zhipu aliases.
ZHIPU_API_KEY=<zhipu-api-key>
ZHIPU_BASE_URL=https://<zhipu-provider-host>/api/paas/v4
ZHIPU_MODEL=<zhipu-model-name>

# Embedding provider. Batch 3 fixes the production baseline to embedding-3 / 2048 dimensions.
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_API_KEY=<embedding-provider-api-key>
EMBEDDING_BASE_URL=https://<embedding-provider-host>/v1
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIMENSIONS=2048
EMBEDDING_TIMEOUT_SECONDS=20
