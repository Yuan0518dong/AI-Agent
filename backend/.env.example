LLM_PROVIDER=openai-compatible
LLM_API_KEY=replace-with-your-api-key
LLM_MODEL=glm-4-flash-250414
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_TIMEOUT_SECONDS=30

# Runtime tool execution policy. Read-only tools may retry once after this timeout;
# write/draft tools never retry automatically and rely on their idempotency checks.
AGENT_TOOL_TIMEOUT_SECONDS=20

# Keep the default test/smoke provider as mock. Configure these explicitly for real embedding runs.
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_API_KEY=replace-with-your-api-key
EMBEDDING_MODEL=replace-with-your-embedding-model
EMBEDDING_BASE_URL=https://your-compatible-provider.example/v1
EMBEDDING_TIMEOUT_SECONDS=30
